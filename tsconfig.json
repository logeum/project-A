{
  "compilerOptions": {
    "target": "ES2022",        // 최신 문법(async/await 등) 사용을 위한 타겟
    "module": "ESNext",        // Vite가 사용하는 ES 모듈 방식
    "moduleResolution": "bundler", // Vite/Wrangler와 궁합이 좋은 해석 방식
    "strict": true,            // 타입 검사를 엄격하게 (버그 예방)
    "noEmit": true,            // tsc는 타입 검사만 하고, 실제 변환은 Vite가 담당
    "lib": ["ES2022", "DOM", "DOM.Iterable"] // 브라우저 API(DOM) 타입 포함
  },
  "include": ["src", "worker"]
}
